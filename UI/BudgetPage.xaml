<Page x:Class="TravelBook.UI.BudgetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок сторінки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="💰" FontSize="28" VerticalAlignment="Center"/>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Бюджет" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Контроль витрат і залишку подорожі" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Картка встановлення бюджету -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="ЗАГАЛЬНИЙ БЮДЖЕТ ПОДОРОЖІ (₴)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="TxtTotalBudget" Style="{StaticResource ModernTextBox}" Width="220"
                             HorizontalAlignment="Left"/>
                </StackPanel>
                
                <!-- Виправлено вертикальне вирівнювання кнопки -->
                <Button Grid.Column="1" Content="Застосувати" Style="{StaticResource PrimaryButton}"
                        Padding="16,0" Height="36" VerticalAlignment="Bottom"
                        Margin="12,0,18,0" Click="BtnSetBudget_Click"/>
                
                <TextBlock Grid.Column="2" Text="📊" FontSize="42" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Картки статистики (Бюджет / Витрачено / Залишок) -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Бюджет" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtBudgetTotal"
           FontSize="22"
           FontWeight="Bold"
           Foreground="#FFF2CC"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Витрачено" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtSpent"
           FontSize="22"
           FontWeight="Bold"
           Foreground="#FF5252"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Залишок" Style="{StaticResource FieldLabel}"/>
                    <TextBlock x:Name="TxtRemaining"
           FontSize="22"
           FontWeight="Bold"
           Foreground="#16F25F"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Основна робоча область -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛІВА ПАНЕЛЬ: Додавання витрат та Статистика -->
            <ScrollViewer Grid.Column="0"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              CanContentScroll="False"
              Margin="0"
              Padding="0">

                <StackPanel Margin="0,0,4,0">

                    <!-- ДОДАВАННЯ ВИТРАТИ -->
                    <Border Style="{StaticResource Card}"
                Margin="0,0,0,16"
                Padding="16">

                        <StackPanel>

                            <TextBlock Text="Додати витрату"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,14"/>

                            <TextBlock Text="НАЗВА"
                           Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TxtExpenseTitle"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,10"/>


                            <TextBlock Text="КАТЕГОРІЯ"
                           Style="{StaticResource FieldLabel}"/>

                            <ComboBox x:Name="CmbExpenseCategory"
                          Style="{StaticResource ModernComboBox}"
                          Margin="0,0,0,10">

                                <ComboBoxItem Content="Житло"
                                  Tag="Housing"
                                  IsSelected="True"/>

                                <ComboBoxItem Content="Транспорт"
                                  Tag="Transport"/>

                                <ComboBoxItem Content="Їжа"
                                  Tag="Food"/>

                                <ComboBoxItem Content="Визначні місця"
                                  Tag="Attractions"/>

                                <ComboBoxItem Content="Інше"
                                  Tag="Other"/>

                            </ComboBox>


                            <TextBlock Text="СУМА (₴)"
                           Style="{StaticResource FieldLabel}"/>

                            <TextBox x:Name="TxtExpenseAmount"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,10"/>


                            <TextBlock Text="ДАТА"
                           Style="{StaticResource FieldLabel}"/>

                            <DatePicker x:Name="DpExpenseDate"
                            Height="36"
                            MinHeight="36"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,14"/>


                            <Button Content="+ Додати витрату"
                        Height="38"
                        Style="{StaticResource AccentButton}"
                        Click="BtnAddExpense_Click"/>

                        </StackPanel>

                    </Border>


                    <!-- СТАТИСТИКА -->
                    <Border Style="{StaticResource Card}"
                Padding="16">

                        <StackPanel>

                            <TextBlock Text="Статистика за категоріями"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,12"/>

                            <ItemsControl x:Name="StatsList">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <StackPanel Margin="0,0,0,12">

                                            <Grid Margin="0,0,0,4">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding Category}"
                                               Foreground="{StaticResource TextBrush}"
                                               FontWeight="SemiBold"/>

                                                <TextBlock Grid.Column="1"
                                               Text="{Binding AmountText}"
                                               Foreground="{StaticResource MutedBrush}"/>

                                            </Grid>

                                            <ProgressBar Height="8"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Percent}"
                                             Background="#191B21"
                                             Foreground="{StaticResource AccentBrush}"/>

                                        </StackPanel>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>


                            <TextBlock x:Name="TxtNoStats"
                           Text="Витрат ще немає"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           Visibility="Collapsed"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- ПРАВА ПАНЕЛЬ: Таблиця витрат із пошуком та фільтрацією -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <!-- Розподіляємо панель на 2 рядки, щоб уникнути накладання елементів -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Рядок 0: Інструменти пошуку та фільтрації -->
                    <Grid Grid.Row="0" Margin="16,16,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="White"
                                CornerRadius="8"
                                BorderBrush="#D0DDD9"
                                BorderThickness="1.5"
                                Margin="0,0,10,0">
                            <Grid>
                                <TextBlock x:Name="ExpenseSearchPlaceholder"
                                           Text="🔍 Пошук витрати..."
                                           Foreground="#BBCCCA"
                                           FontSize="13"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>

                                <TextBox x:Name="TxtExpenseSearch"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="12,8"
                                         Foreground="{StaticResource TextBrush}"
                                         TextChanged="ExpenseFilter_Changed"
                                         GotFocus="TxtExpenseSearch_GotFocus"
                                         LostFocus="TxtExpenseSearch_LostFocus"/>
                            </Grid>
                        </Border>

                        <ComboBox x:Name="CmbExpenseFilter"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="ExpenseFilter_Changed">
                            <ComboBoxItem Content="Всі категорії" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Житло" Tag="Housing"/>
                            <ComboBoxItem Content="Транспорт" Tag="Transport"/>
                            <ComboBoxItem Content="Їжа" Tag="Food"/>
                            <ComboBoxItem Content="Визначні місця" Tag="Attractions"/>
                            <ComboBoxItem Content="Інше" Tag="Other"/>
                        </ComboBox>
                    </Grid>

                    <!-- Рядок 1: Таблиця та стан порожнього списку (відокремлені від пошуку) -->
                    <Grid Grid.Row="1">
                        <!-- DataGrid тепер займає весь виділений простір без зайвих відступів зверху -->
                        <DataGrid x:Name="GridExpenses"
                                  Margin="16,8,16,16"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  RowBackground="White"
                                  AlternatingRowBackground="#FAFCFB"
                                  FontSize="13"
                                  ColumnHeaderHeight="38"
                                  RowHeight="40">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#F5F7F6"/>
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Назва" Binding="{Binding Title}" Width="*" MinWidth="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Padding" Value="14,0"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryDisplayName}" Width="130"/>
                                <DataGridTextColumn Header="Сума (₴)" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110"/>
                                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                                <DataGridTemplateColumn Header="" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑" Tag="{Binding}" Style="{StaticResource DangerButton}"
                                                    Padding="8,4" FontSize="12" Click="BtnRemoveExpense_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel x:Name="EmptyExpensesState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="🧾" FontSize="46" HorizontalAlignment="Center"/>
                            <TextBlock Text="Витрат ще немає" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="Додайте першу витрату ліворуч або змініть фільтр" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
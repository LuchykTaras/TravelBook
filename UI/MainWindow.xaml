<Window x:Class="TravelBook.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TravelBook"
        Width="1240"
        Height="780"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Border Margin="7"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="7">

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================= -->
            <!--                     SIDEBAR                       -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#080A10"
                    BorderBrush="{StaticResource AccentDarkBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="7,0,0,7">

                <Grid Margin="16,24">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ЛОГОТИП -->

                    <StackPanel Grid.Row="0"
                                Margin="0,0,0,32">

                        <TextBlock Text="TRAVELBOOK"
                                   FontFamily="Georgia"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   HorizontalAlignment="Center"/>

                        <Border Height="1"
                                Margin="10,8,10,7"
                                Background="{StaticResource AccentBrush}"
                                Opacity="0.7"/>

                        <TextBlock Text="YOUR JOURNEY • YOUR STORY"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- НАВІГАЦІЯ -->

                    <StackPanel Grid.Row="1">

                        <Button Style="{StaticResource NavButton}"
                                Click="BtnCities_Click"
                                Margin="0,0,0,8">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="◇"
                                           FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Міста та села"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <Button Style="{StaticResource NavButton}"
                                Click="BtnTraditions_Click"
                                Margin="0,0,0,8">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="✦"
                                           FontSize="13"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Традиції"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <Button Style="{StaticResource NavButton}"
                                Click="BtnRoutes_Click"
                                Margin="0,0,0,8">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="∿"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Маршрути"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>


                        <Button Style="{StaticResource NavButton}"
                                Click="BtnBudget_Click">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="◈"
                                           FontSize="14"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="Бюджет"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Button>

                    </StackPanel>


                    <!-- ДЕКОРАТИВНИЙ ОРНАМЕНТ -->

                    <StackPanel Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,20">

                        <StackPanel.Effect>
                            <DropShadowEffect Color="#C79A3B"
                                              BlurRadius="10"
                                              ShadowDepth="0"
                                              Opacity="0.50"/>
                        </StackPanel.Effect>

                        <TextBlock Text="◇"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>

                        <Rectangle Width="1"
                                   Height="40"
                                   Fill="{StaticResource AccentDarkBrush}"
                                   Margin="0,4"/>

                        <TextBlock Text="✦"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>

                        <Rectangle Width="1"
                                   Height="40"
                                   Fill="{StaticResource AccentDarkBrush}"
                                   Margin="0,4"/>

                        <TextBlock Text="◇"
                                   FontSize="16"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- НИЖНЯ ПАНЕЛЬ -->

                    <Border Grid.Row="3"
                            Background="#0D111A"
                            BorderBrush="{StaticResource AccentDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="12,10">

                        <StackPanel HorizontalAlignment="Center">

                            <TextBlock Text="TRAVEL JOURNAL"
                                       FontFamily="Georgia"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"/>

                            <TextBlock Text="EXPLORE • REMEMBER • DISCOVER"
                                       FontSize="7.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!--                  MAIN CONTENT                     -->
            <!-- ================================================= -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="92"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->

                <Border Grid.Row="0"
                        Background="#06080D"
                        BorderBrush="{StaticResource AccentDarkBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="24,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center">

                            <TextBlock Text="TRAVELBOOK"
                                       FontFamily="Georgia"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>

                            <TextBlock Text="YOUR JOURNEY. YOUR STORY. YOUR LEGEND."
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Margin="2,3,0,0"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Height="38"
                                Padding="14,0"
                                VerticalAlignment="Center"
                                Background="#0D1018"
                                BorderBrush="{StaticResource AccentDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="4">

                            <TextBlock Text="✦  TRAVEL JOURNAL"
                                       FontFamily="Georgia"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- FRAME -->

                <Border Grid.Row="1"
                        Margin="14"
                        Background="{StaticResource BackgroundBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8">

                    <Border Margin="4"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource AccentDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="5">

                        <Frame x:Name="MainFrame"
                               NavigationUIVisibility="Hidden"
                               Background="{StaticResource BackgroundBrush}"/>

                    </Border>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>
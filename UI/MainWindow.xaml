<Window x:Class="TravelBook.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Title="TravelBook"

        Width="1280"
        Height="800"

        MinWidth="1050"
        MinHeight="680"

        WindowStartupLocation="CenterScreen"

        Background="{StaticResource BackgroundBrush}">

    <!-- ЗОВНІШНЯ ЗОЛОТА РАМКА -->

    <Border Margin="7"
            Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="7">

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="235"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- ============================================ -->
            <!--                   SIDEBAR                    -->
            <!-- ============================================ -->

            <Border Grid.Column="0"
                    Background="#090B12"
                    BorderBrush="{StaticResource AccentDarkBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="7,0,0,7">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- НАЗВА -->

                    <StackPanel Grid.Row="0"
                                Margin="18,28,18,30">

                        <TextBlock
                            Text="TRAVELBOOK"
                            Foreground="{StaticResource TextBrush}"
                            FontFamily="Georgia"
                            FontWeight="Bold"
                            FontSize="26"
                            HorizontalAlignment="Center"/>

                        <Border
                            Height="1"
                            Margin="18,10,18,8"
                            Background="{StaticResource AccentBrush}"/>

                        <TextBlock
                            Text="YOUR JOURNEY • YOUR STORY"
                            Foreground="{StaticResource AccentBrush}"
                            FontSize="8"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"/>

                    </StackPanel>


                    <!-- НАВІГАЦІЯ -->

                    <StackPanel Grid.Row="1">

                        <Button
                            Content="◇   Міста та села"
                            Style="{StaticResource NavButton}"
                            Click="BtnCities_Click"/>

                        <Button
                            Content="✦   Традиції"
                            Style="{StaticResource NavButton}"
                            Click="BtnTraditions_Click"/>

                        <Button
                            Content="⌁   Маршрути"
                            Style="{StaticResource NavButton}"
                            Click="BtnRoutes_Click"/>

                        <Button
                            Content="◈   Бюджет"
                            Style="{StaticResource NavButton}"
                            Click="BtnBudget_Click"/>

                    </StackPanel>


                    <!-- ДЕКОРАТИВНА ЦЕНТРАЛЬНА ЧАСТИНА -->

                    <Grid Grid.Row="2">

                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Opacity="0.6">

                            <TextBlock
                                Text="◇"
                                FontSize="28"
                                Foreground="{StaticResource AccentDarkBrush}"
                                HorizontalAlignment="Center"/>

                            <Border
                                Width="1"
                                Height="45"
                                Background="{StaticResource AccentDarkBrush}"/>

                            <TextBlock
                                Text="✦"
                                Margin="0,5"
                                FontSize="21"
                                Foreground="{StaticResource AccentBrush}"
                                HorizontalAlignment="Center"/>

                            <Border
                                Width="1"
                                Height="45"
                                Background="{StaticResource AccentDarkBrush}"/>

                            <TextBlock
                                Text="◇"
                                FontSize="28"
                                Foreground="{StaticResource AccentDarkBrush}"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Grid>


                    <!-- НИЖНІЙ ДЕКОР -->

                    <Border Grid.Row="3"
                            Margin="15,15,15,18"
                            Padding="12"
                            Background="#0D0F17"
                            BorderBrush="{StaticResource AccentDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="5">

                        <StackPanel>

                            <TextBlock
                                Text="TRAVEL JOURNAL"
                                FontFamily="Georgia"
                                Foreground="{StaticResource AccentBrush}"
                                FontSize="11"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"/>

                            <TextBlock
                                Text="EXPLORE  •  REMEMBER  •  DISCOVER"
                                Foreground="{StaticResource MutedBrush}"
                                FontSize="8"
                                Margin="0,5,0,0"
                                HorizontalAlignment="Center"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ============================================ -->
            <!--                MAIN CONTENT                  -->
            <!-- ============================================ -->

            <Grid Grid.Column="1">

                <Grid.RowDefinitions>

                    <RowDefinition Height="98"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- ВЕРХНІЙ HEADER -->

                <Border Grid.Row="0"
                        Background="#0A0C13"
                        BorderBrush="{StaticResource AccentDarkBrush}"
                        BorderThickness="0,0,0,1">

                    <Grid Margin="24,0">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="TRAVELBOOK"
                                FontFamily="Georgia"
                                FontWeight="Bold"
                                FontSize="31"
                                Foreground="{StaticResource TextBrush}"/>

                            <TextBlock
                                Text="YOUR JOURNEY. YOUR STORY. YOUR LEGEND."
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentBrush}"
                                Margin="2,4,0,0"/>

                        </StackPanel>


                        <Border Grid.Column="1"
                                Height="36"
                                Padding="14,0"
                                VerticalAlignment="Center"
                                Background="#0D1018"
                                BorderBrush="{StaticResource AccentDarkBrush}"
                                BorderThickness="1"
                                CornerRadius="4">

                            <TextBlock
                                Text="✦  TRAVEL JOURNAL"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource AccentLightBrush}"
                                FontFamily="Georgia"
                                FontSize="11"/>

                        </Border>

                    </Grid>

                </Border>


                <!-- СТОРІНКИ -->

                <Border Grid.Row="1"
                        Margin="17"
                        Background="{StaticResource BackgroundSecondaryBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6">

                    <Border
                        Margin="4"
                        BorderBrush="#342617"
                        BorderThickness="1"
                        CornerRadius="4">

                        <Frame
                            x:Name="MainFrame"
                            NavigationUIVisibility="Hidden"
                            Background="{StaticResource BackgroundBrush}"/>

                    </Border>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>
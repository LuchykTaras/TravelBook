<Page x:Class="TravelBook.UI.RoutePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🗺" FontSize="28" VerticalAlignment="Center"/>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Маршрути" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TxtRouteCount" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,16,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Збережені маршрути"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="+ Новий"
                                Style="{StaticResource GhostButton}"
                                Padding="10,6"
                                Click="BtnNewRoute_Click"/>
                    </Grid>

                    <Border DockPanel.Dock="Top"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#D0DDD9"
                            BorderThickness="1.5"
                            Margin="16,0,16,12">
                        <Grid>
                            <TextBlock x:Name="RouteSearchPlaceholder"
                                       Text="🔍 Пошук маршруту..."
                                       Foreground="#BBCCCA"
                                       FontSize="13"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>

                            <TextBox x:Name="TxtRouteSearch"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="12,8"
                                     Foreground="{StaticResource TextBrush}"
                                     TextChanged="TxtRouteSearch_TextChanged"
                                     GotFocus="TxtRouteSearch_GotFocus"
                                     LostFocus="TxtRouteSearch_LostFocus"/>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LstRoutes"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="12,0,12,12"
                             ItemContainerStyle="{StaticResource CityListItem}"
                             SelectionChanged="LstRoutes_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="34" Height="34" Background="#EDF5F3" CornerRadius="8">
                                        <TextBlock Text="🧭" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>

                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0} міст · {1:dd.MM.yyyy}">
                                                    <Binding Path="Cities.Count"/>
                                                    <Binding Path="CreatedDate"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="НАЗВА МАРШРУТУ" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="TxtRouteName" Style="{StaticResource ModernTextBox}"/>
                            <TextBlock x:Name="TxtSelectedInfo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="✈"
                                   FontSize="42"
                                   Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="20,0,4,0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="ДОДАТИ МІСТО ДО МАРШРУТУ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CmbCities" Style="{StaticResource ModernComboBox}"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="+ Додати"
                                Style="{StaticResource AccentButton}"
                                Margin="12,20,0,0"
                                Click="BtnAddCity_Click"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <ListBox x:Name="LstRouteCities"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="12"
                                 ItemContainerStyle="{StaticResource CityListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34" Background="#EDF5F3" CornerRadius="17">
                                            <TextBlock Text="📍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>

                                            <TextBlock Text="{Binding Country}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="⋮"
                                                   FontSize="18"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyRouteState"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="🧳" FontSize="46" HorizontalAlignment="Center"/>
                            <TextBlock Text="У маршруті ще немає міст" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock Text="Оберіть місто вище та додайте його до списку" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="↑ Вгору"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Click="BtnMoveUp_Click"/>

                    <Button Grid.Column="1"
                            Content="↓ Вниз"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Click="BtnMoveDown_Click"/>

                    <Button Grid.Column="2"
                            Content="Прибрати"
                            Style="{StaticResource GhostButton}"
                            Click="BtnRemoveCity_Click"/>

                    <Button Grid.Column="4"
                            Content="🗑 Видалити маршрут"
                            Style="{StaticResource DangerButton}"
                            Margin="0,0,8,0"
                            Click="BtnDeleteRoute_Click"/>

                    <Button Grid.Column="5"
                            Content="💾 Зберегти"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnSaveRoute_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>

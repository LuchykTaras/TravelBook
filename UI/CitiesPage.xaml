<Page x:Class="TravelBook.UI.CitiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0"
              Margin="0,0,0,22">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Text="EXPLORE THE REALMS"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AccentBrush}"/>

                <TextBlock
                    Text="Міста та села"
                    FontFamily="Georgia"
                    FontSize="25"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextBrush}"
                    Margin="0,4,0,2"/>

                <TextBlock
                    x:Name="TxtCityCount"
                    FontSize="12"
                    Foreground="{StaticResource MutedBrush}"/>

            </StackPanel>


            <TextBlock
                Grid.Column="1"
                Text="◇"
                Foreground="{StaticResource AccentDarkBrush}"
                FontSize="38"
                VerticalAlignment="Center"/>

        </Grid>


        <!-- SEARCH -->

        <Grid Grid.Row="1"
              Margin="0,0,0,18">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <Border
                Grid.Column="0"
                Height="40"
                Margin="0,0,12,0"
                Background="#090B12"
                BorderBrush="{StaticResource AccentDarkBrush}"
                BorderThickness="1"
                CornerRadius="5">

                <Grid>

                    <TextBlock
                        x:Name="SearchPlaceholder"
                        Text="⌕   Пошук міста, села або країни…"
                        Foreground="{StaticResource MutedBrush}"
                        FontSize="13"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"/>

                    <TextBox
                        x:Name="TxtSearch"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        Padding="12,8"
                        Foreground="{StaticResource TextBrush}"
                        CaretBrush="{StaticResource AccentLightBrush}"
                        TextChanged="TxtSearch_TextChanged"
                        GotFocus="TxtSearch_GotFocus"
                        LostFocus="TxtSearch_LostFocus"/>

                </Grid>

            </Border>


            <Button
                Grid.Column="1"
                Content="+  Додати місто/село"
                Style="{StaticResource PrimaryButton}"
                Click="BtnAdd_Click"/>

        </Grid>


        <!-- CITY LIST -->

        <ListBox
            x:Name="LstCities"
            Grid.Row="2"
            Background="Transparent"
            BorderThickness="0"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ItemContainerStyle="{StaticResource CityListItem}"
            SelectionChanged="LstCities_SelectionChanged">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <Border
                            Grid.Column="0"
                            Width="44"
                            Height="44"
                            Background="#14261F"
                            BorderBrush="{StaticResource AccentDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="22">

                            <TextBlock
                                Text="◇"
                                FontSize="20"
                                Foreground="{StaticResource AccentLightBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding Name}"
                                FontFamily="Georgia"
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextBrush}"/>

                            <TextBlock
                                Text="{Binding Country}"
                                FontSize="11"
                                Foreground="{StaticResource MutedBrush}"
                                Margin="0,3,0,0"/>

                        </StackPanel>


                        <Border
                            Grid.Column="2"
                            Padding="11,5"
                            VerticalAlignment="Center"
                            Background="#20190C"
                            BorderBrush="{StaticResource AccentDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="10">

                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource AccentLightBrush}">

                                <TextBlock.Text>

                                    <MultiBinding StringFormat="{}{0} пам.">

                                        <Binding Path="Attractions.Count"/>

                                    </MultiBinding>

                                </TextBlock.Text>

                            </TextBlock>

                        </Border>

                    </Grid>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>


        <!-- EMPTY STATE -->

        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed">

            <TextBlock
                Text="◇"
                FontSize="48"
                Foreground="{StaticResource AccentBrush}"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Міста чи села ще не додано"
                FontFamily="Georgia"
                FontSize="17"
                FontWeight="Bold"
                Foreground="{StaticResource TextBrush}"
                HorizontalAlignment="Center"
                Margin="0,10,0,5"/>

            <TextBlock
                Text="Додайте перший пункт своєї подорожі"
                FontSize="12"
                Foreground="{StaticResource MutedBrush}"
                HorizontalAlignment="Center"/>

        </StackPanel>

    </Grid>

</Page>
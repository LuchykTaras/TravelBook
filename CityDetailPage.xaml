<Page x:Class="TravelBook.UI.CityDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="← Назад"
                    Style="{StaticResource GhostButton}"
                    Padding="10,6"
                    Click="BtnBack_Click"
                    Margin="0,0,12,0"/>

            <TextBlock x:Name="TxtPageTitle"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtCountry"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"/>

                    <TextBlock x:Name="TxtDescription"
                               FontSize="13"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <Image x:Name="ImgCity"
                           MaxHeight="140"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Button Content="✏ Редагувати"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,0,8"
                            Click="BtnEditCity_Click"/>

                    <Button Content="🗑 Видалити"
                            Style="{StaticResource DangerButton}"
                            Click="BtnDeleteCity_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Пам'ятки"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="8"
                    BorderBrush="#D0DDD9"
                    BorderThickness="1.5"
                    Margin="0,0,10,0">
                <Grid>
                    <TextBlock x:Name="AttractionSearchPlaceholder"
                               Text="🔍 Пошук пам'ятки за назвою або адресою..."
                               Foreground="#BBCCCA"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>

                    <TextBox x:Name="TxtAttractionSearch"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="13"
                             Padding="12,8"
                             Foreground="{StaticResource TextBrush}"
                             TextChanged="TxtAttractionSearch_TextChanged"
                             GotFocus="TxtAttractionSearch_GotFocus"
                             LostFocus="TxtAttractionSearch_LostFocus"/>
                </Grid>
            </Border>

            <ComboBox x:Name="CmbFilter"
                      Grid.Column="2"
                      Style="{StaticResource ModernComboBox}"
                      Width="160"
                      Margin="0,0,10,0"
                      SelectionChanged="CmbFilter_SelectionChanged">
                <ComboBoxItem Content="Всі категорії" IsSelected="True" Tag="All"/>
                <ComboBoxItem Content="Музей" Tag="Museum"/>
                <ComboBoxItem Content="Парк" Tag="Park"/>
                <ComboBoxItem Content="Ресторан" Tag="Restaurant"/>
                <ComboBoxItem Content="Готель" Tag="Hotel"/>
                <ComboBoxItem Content="Інше" Tag="Other"/>
            </ComboBox>

            <Button Grid.Column="3"
                    Content="+ Пам'ятка"
                    Style="{StaticResource AccentButton}"
                    Click="BtnAddAttraction_Click"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid x:Name="GridAttractions"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F0F0"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFCFB"
                          FontSize="13"
                          ColumnHeaderHeight="38"
                          RowHeight="40">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F7F6"/>
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="14,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*" MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Категорія" Binding="{Binding CategoryDisplayName}" Width="110"/>
                        <DataGridTextColumn Header="Адреса" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Ціна (₴)" Binding="{Binding EntryPrice, StringFormat={}{0:N0}}" Width="90"/>

                        <DataGridTextColumn Header="Рейтинг" Binding="{Binding RatingStars}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E6A817"/>
                                    <Setter Property="Padding" Value="14,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <Button Content="✏"
                                                Tag="{Binding}"
                                                Style="{StaticResource GhostButton}"
                                                Padding="8,4"
                                                FontSize="12"
                                                Margin="0,0,4,0"
                                                Click="BtnEditAttr_Click"/>

                                        <Button Content="🗑"
                                                Tag="{Binding}"
                                                Style="{StaticResource DangerButton}"
                                                Padding="8,4"
                                                FontSize="12"
                                                Click="BtnDeleteAttr_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="EmptyAttractionsState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="🗿" FontSize="46" HorizontalAlignment="Center"/>
                    <TextBlock Text="Пам'яток не знайдено" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                    <TextBlock Text="Додайте пам'ятку або змініть пошук/фільтр" FontSize="13"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

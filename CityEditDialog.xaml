<Window x:Class="TravelBook.UI.CityEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Місто" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="NoResize">
    <StackPanel Margin="28">
        <TextBlock x:Name="TitleLabel" Text="Додати місто/село"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>

        <TextBlock Text="НАЗВА МІСТА/СЕЛА" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="КРАЇНА" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtCountry" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14"/>

        <TextBlock Text="ОПИС" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="TxtDescription" Style="{StaticResource ModernTextBox}"
                 Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

        <TextBlock Text="ШЛЯХ ДО ФОТО" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtImagePath" Style="{StaticResource ModernTextBox}"
                     Grid.Column="0" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="…" Style="{StaticResource GhostButton}"
                    Padding="12,7" Click="BtnBrowse_Click"/>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Скасувати" Style="{StaticResource GhostButton}"
                    Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="Зберегти"
                    Style="{StaticResource PrimaryButton}" Click="BtnSave_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
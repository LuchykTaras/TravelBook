<Page x:Class="TravelBook.UI.TraditionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:TravelBook.UI"
      Background="{StaticResource BackgroundBrush}"
      Loaded="Page_Loaded">

    <Page.Resources>
        <!-- Конвертер для перетворення відносного шляху на реальне зображення -->
        <local:ImagePathConverter x:Key="ImagePathConverter"/>

        <!-- Стиль для бігунка скролбару (Thumb) -->
        <Style x:Key="VisibleScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#4CAF87"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Власний стиль вертикального скролбару (слайд-бару) з помітною підкладкою -->
        <Style x:Key="VisibleScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <!-- Тонка світла підкладка, щоб було видно межі скролбару -->
            <Setter Property="Background" Value="#F0F4F2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <!-- Фон скролбару -->
                            <Border Background="{TemplateBinding Background}" CornerRadius="5"/>
                            <Track Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource VisibleScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Width="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Width="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шаблон ScrollViewer, який розміщує скролбар чітко праворуч -->
        <Style x:Key="VisibleScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <!-- Примусово показуємо скролбар завжди -->
                            <ScrollBar Grid.Column="1"
                                       Name="PART_VerticalScrollBar"
                                       Style="{StaticResource VisibleScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="Visible"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок сторінки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="🏮" FontSize="28" VerticalAlignment="Center"/>
            <StackPanel Margin="10,0,0,0">
                <TextBlock Text="Культурні традиції" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TxtTraditionsCount" Text="0 традицій у базі" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Панель пошуку та додавання -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="8"
                    BorderBrush="#D0DDD9" BorderThickness="1.5" Margin="0,0,10,0">
                <Grid>
                    <TextBlock x:Name="SearchPlaceholder" Text="🔍  Пошук за країною, містом або назвою села..."
                               Foreground="#BBCCCA" FontSize="13"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox x:Name="TxtSearch" Background="Transparent" BorderThickness="0"
                             FontSize="13" Padding="12,8" Foreground="{StaticResource TextBrush}"
                             TextChanged="TxtSearch_TextChanged"
                             GotFocus="TxtSearch_GotFocus"
                             LostFocus="TxtSearch_LostFocus"/>
                </Grid>
            </Border>

            <Button Grid.Column="1" Content="+ Додати традицію"
                    Style="{StaticResource PrimaryButton}" Click="BtnAddTradition_Click"/>
        </Grid>

        <!-- Список традицій -->
        <Grid Grid.Row="2">
            <ListBox x:Name="LstTraditions"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.CanContentScroll="False"
                     ItemContainerStyle="{StaticResource CityListItem}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Style="{StaticResource VisibleScrollViewer}" Padding="0,0,10,0">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Рядок 0: Заголовок та кнопки дії -->
                                <RowDefinition Height="Auto"/>
                                <!-- Рядок 1: Опис звичаю -->
                                <RowDefinition Height="Auto"/>
                                <!-- Рядок 2: Мітки -->
                                <RowDefinition Height="Auto"/>
                                <!-- Рядок 3: Динамічне фото -->
                            </Grid.RowDefinitions>

                            <!-- Рядок 0: Заголовок та кнопки керування -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Кнопка Редагувати: олівець яскраво-жовтого кольору -->
                                    <Button Tag="{Binding}" Style="{StaticResource NavButton}"
                                            Padding="8,6" Margin="0,0,8,0" Click="BtnEditTradition_Click">
                                        <TextBlock Text="✏️" FontSize="15" Foreground="#FFD700" FontWeight="Bold"/>
                                    </Button>

                                    <!-- Кнопка Видалити -->
                                    <Button Content="🗑" Tag="{Binding Id}" Style="{StaticResource DangerButton}"
                                            Padding="10,6" FontSize="12" Click="BtnDeleteTradition_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Рядок 1: Опис звичаю -->
                            <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="13" Margin="0,0,0,8"
                                       Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>

                            <!-- Рядок 2: Географічні мітки -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="#E2ECE9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding Country}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                                <Border Background="#F5F7F6" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{Binding CityOrVillage}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Рядок 3: Повністю динамічне фото без обрізання -->
                            <Border Grid.Row="3" CornerRadius="12" ClipToBounds="True"
                                    Background="#EDF5F3" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                                <Grid>
                                    <!-- Текстова іконка-заглушка (ліхтарик позаду на випадок відсутності фото) -->
                                    <TextBlock Text="🏮" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3" Margin="0,40"/>

                                    <!-- Фотографія: розтягується під розмір вікна, але завжди показує 100% зображення (Uniform) -->
                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                           Stretch="Uniform" 
                                           MaxHeight="450"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Екран, коли традицій ще немає в базі -->
            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <TextBlock Text="🏮" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Традицій ще не додано" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <TextBlock Text="Внесіть перший звичай, традицію чи легенду!" FontSize="13"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>